{
  "name": "@vectorchi/nuxt-fun-loader",
  "version": "0.1.0",
  "description": "Rotating, playful loading messages for Nuxt, with only the themes you use in the bundle.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VectorChi/nuxt-fun-loader.git"
  },
  "homepage": "https://vectorchi.github.io/fun-loader/",
  "bugs": "https://github.com/VectorChi/nuxt-fun-loader/issues",
  "license": "MIT",
  "author": "Adimchi Oka",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "loading",
    "loader",
    "web-component",
    "fun-loader"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "size": "node scripts/size.ts"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "@vectorchi/fun-loader": "^0.5.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.2",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
